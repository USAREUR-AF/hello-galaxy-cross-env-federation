#!/usr/bin/env bash
# hello-galaxy-cross-env-federation — the runner.
set -uo pipefail
cd "$(dirname "$0")"
export HG_ROOT="$PWD"

: "${GOAT_BIN:=$(command -v goat || true)}"
: "${FED_TOOL:=goat}"
: "${GOATBUILDER_BIN:=$(command -v goatbuilder || true)}"
export GOAT_BIN FED_TOOL GOATBUILDER_BIN

usage() {
  echo "usage: ./run [--list] [stage...]"
  echo "  ./run           every built stage"
  echo "  ./run 03 04     just those"
  echo "  ./run --list    what exists and what does not"
}

if [ "${1:-}" = "--list" ]; then
  echo "built:"
  for f in stages/*.sh; do
    printf "  %-4s %s\n" "$(basename "$f" | cut -d- -f1)" "$(sed -n '2s/^# //p' "$f")"
  done
  echo "every stage above is built; see STAGES.md for what each one proves"
  echo "  09/11 are the data path; 10 is grant-keying inside one goatnet;"
  echo "  12 is grant-keying ACROSS the boundary and needs both cloud sides"
  exit 0
fi
[ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] && { usage; exit 0; }

# The federation verbs come from `goat` (the default, what partners run today) or
# from `goatbuilder` (FED_TOOL=goatbuilder), which they are moving to. lib/fed.sh.
case "$FED_TOOL" in
  goat)
    if [ -z "$GOAT_BIN" ] || [ ! -x "$GOAT_BIN" ]; then
      echo "no goat binary. Put one on PATH or set GOAT_BIN." >&2
      echo "Releases: https://github.com/usareur-af/goatcore/releases (goat-cli-v*)" >&2
      exit 2
    fi ;;
  goatbuilder)
    if [ -z "$GOATBUILDER_BIN" ] || [ ! -x "$GOATBUILDER_BIN" ]; then
      echo "FED_TOOL=goatbuilder and no goatbuilder binary. Put one on PATH or set GOATBUILDER_BIN." >&2
      echo "Releases: https://github.com/usareur-af/goatcore/releases (goatbuilder/v*)" >&2
      exit 2
    fi
    # An older goatbuilder reads `federate lint` as a peering named "lint"; its
    # help then shows no `federate lint` usage line. Refuse it rather than run it.
    if ! "$GOATBUILDER_BIN" federate lint --help 2>/dev/null | grep -q 'federate lint'; then
      echo "$("$GOATBUILDER_BIN" --version 2>/dev/null || echo "$GOATBUILDER_BIN") has no 'federate lint' verb." >&2
      echo "FED_TOOL=goatbuilder needs the first goatbuilder release that carries the federate verbs;" >&2
      echo "unset FED_TOOL to run the stages with the released goat CLI." >&2
      exit 2
    fi ;;
  *)
    echo "FED_TOOL is '$FED_TOOL'; it is goat (the default) or goatbuilder." >&2
    exit 2 ;;
esac

echo
if [ "$FED_TOOL" = goatbuilder ]; then
  echo "  federate: goatbuilder federate ($("$GOATBUILDER_BIN" --version 2>/dev/null || echo "$GOATBUILDER_BIN"))"
else
  echo "  federate: goat federate ($("$GOAT_BIN" --version 2>/dev/null || echo "$GOAT_BIN"))"
fi
echo "  bundle: $(ls bundle/*.tar.gz 2>/dev/null | head -1 || echo 'will be fetched')"

want=("$@")
total_fail=0; total_skip=0
for f in stages/*.sh; do
  n=$(basename "$f" | cut -d- -f1)
  if [ ${#want[@]} -gt 0 ]; then
    match=0; for w in "${want[@]}"; do [ "$w" = "$n" ] && match=1; done
    [ $match -eq 1 ] || continue
  fi
  echo
  echo "── $n  $(sed -n '2s/^# //p' "$f")"
  out=$(bash "$f" 2>&1); rc=$?
  printf '%s\n' "$out"
  [ $rc -eq 0 ] || total_fail=$((total_fail+1))
  # count the skip MARKER only — the tally line also contains the word
  s=$(printf '%s' "$out" | grep -c '^  .*skip.*  ' || true)
  total_skip=$((total_skip + s))
done

echo
if [ $total_fail -ne 0 ]; then
  echo "  $total_fail STAGE(S) FAILED"
elif [ $total_skip -ne 0 ]; then
  # A skip is not a pass. Say so on the last line, where people stop reading.
  echo "  PASSED, WITH $total_skip CHECK(S) SKIPPED — see the skip lines above for why"
else
  echo "  ALL STAGES PASSED"
fi
exit $total_fail
